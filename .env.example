APP_ENV=local
APP_URL=http://localhost:8088
APP_PORT=8088
APP_NAME="ศูนย์การศึกษาอาชีพ วิทยาลัยเทคนิคกำแพงเพชร"
APP_KEY=replace-with-random-64-hex-characters
DB_HOST=db
DB_PORT=3306
DB_DATABASE=vekec_lms
DB_USERNAME=vekec
DB_PASSWORD=replace-with-a-random-password
DB_ROOT_PASSWORD=replace-with-another-random-password
ADMIN_EMAIL=admin@kpt.ac.th
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME="ผู้ดูแลระบบ"
THAID_ENABLED=false
THAID_CLIENT_ID=
THAID_CLIENT_SECRET=
THAID_API_KEY=
THAID_DISCOVERY_URL=https://imauth.bora.dopa.go.th/.well-known/openid-configuration
THAID_REDIRECT_URI=https://vekec.kpt.ac.th/auth/thaid/callback
THAID_SCOPE="openid pid name given_name family_name"
THAID_API_KEY_HEADER=apikey
THAID_PKCE=true

# Teacher BYOK. Generate an independent 32-byte key: openssl rand -base64 32
# Keep it outside source control; losing/changing it makes existing saved credentials unreadable.
AI_ENABLED=false
AI_CREDENTIALS_ENCRYPTION_KEY=
# Legacy model allowlists: imported into OpenAI catalog on migration 007 only.
# After migration, manage providers and models from /admin/ai-providers instead.
AI_TEXT_MODELS=
AI_SPEECH_MODELS=
AI_EMBEDDING_MODELS=
AI_INSTITUTION_API_KEY=
AI_INSTITUTION_PROVIDER=openai
AI_INSTITUTION_TEACHER_ACCESS=false

# USD per 1 million tokens, keyed by provider slug and exact model ID.
# Set current upper-bound rates from your provider (include context tiers/surcharges).
# Prefer Admin > AI Providers > Text pricing (takes effect immediately).
# This JSON is a fallback when no web price exists. Unpriced models cannot generate.
AI_TEXT_PRICING_JSON='{}'
